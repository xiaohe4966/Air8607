 /**
+ * 删除图片缓存里某个路径的条目
+ * @api airui.cache_drop(src)
+ * @string src 图片路径，缓存里按路径做键（不含修改时间/大小）
+ * @return bool 成功返回 true
+ * @note 同一个路径换了内容后调用它，下次绘制就会重新读文件解码。
+ *       整屏照片的解码缓冲（w*h*3）和缓存条目抢同一个池子，
+ *       换图前删掉旧条目可以保证解码一定分配得到内存。
+ */
+static int l_airui_cache_drop(lua_State *L) {
+    const char * src = luaL_checkstring(L, 1);
+    lv_image_cache_drop(src);
+    lua_pushboolean(L, 1);
+    return 1;
+}
+
+/**
+ * 调整图片缓存上限
+ * @api airui.cache_resize(size)
+ * @int size 新的上限字节数，0 表示关闭图片缓存
+ * @return bool 成功返回 true
+ */
+static int l_airui_cache_resize(lua_State *L) {
+    lua_Integer size = luaL_checkinteger(L, 1);
+    if (size < 0) {
+        size = 0;
+    }
+    lv_image_cache_resize((uint32_t)size, true);
+    lua_pushboolean(L, 1);
+    return 1;
+}
+
